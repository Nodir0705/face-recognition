<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAF7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header: title + Back -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings"
                android:textColor="#222222"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/configButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/settings_config_button"
                android:textColor="#222222"
                android:background="@drawable/btn_secondary_bg" />

            <Button
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/back"
                android:textColor="#222222"
                android:background="@drawable/btn_secondary_bg" />
        </LinearLayout>

        <!-- Employees -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="28dp">

            <TextView
                android:id="@+id/employeesHeading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#222222"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/addEmployeeButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_add_employee"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_primary_bg" />
        </LinearLayout>

        <!-- Enrolled-users table: elevated card holding a static column header
             (its column metrics MUST match item_user.xml), a thin on-brand
             accent rule, then the data rows. clipToOutline + uniform-radius
             card bg clips the header's top + last row's bottom corners. -->
        <LinearLayout
            android:id="@+id/usersTableCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/table_card_bg"
            android:elevation="4dp"
            android:clipToOutline="true">

            <!-- Static header row — columns aligned with item_user.xml -->
            <LinearLayout
                android:id="@+id/usersHeaderRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/table_header_bg"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/col_index"
                    android:textAllCaps="true"
                    android:letterSpacing="0.06"
                    android:textColor="#8A867C"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="4"
                    android:layout_marginStart="12dp"
                    android:text="@string/col_name"
                    android:textAllCaps="true"
                    android:letterSpacing="0.06"
                    android:textColor="#8A867C"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:layout_marginStart="12dp"
                    android:text="@string/col_empid"
                    android:textAllCaps="true"
                    android:letterSpacing="0.06"
                    android:textColor="#8A867C"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="4"
                    android:layout_marginStart="12dp"
                    android:text="@string/col_department"
                    android:textAllCaps="true"
                    android:letterSpacing="0.06"
                    android:textColor="#8A867C"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:gravity="center"
                    android:text="@string/col_action"
                    android:textAllCaps="true"
                    android:letterSpacing="0.06"
                    android:textColor="#8A867C"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Thin on-brand accent rule under the header band -->
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@drawable/table_header_accent" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/usersRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/usersEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/settings_no_employees"
            android:textColor="#6A6A66"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
