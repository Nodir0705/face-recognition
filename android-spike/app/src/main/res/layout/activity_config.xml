<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAF7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header: title + Back -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/config_title"
                android:textColor="#222222"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/back"
                android:textColor="#222222"
                android:background="@drawable/btn_secondary_bg" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/config_subtitle"
            android:textColor="#6A6A66"
            android:textSize="14sp" />

        <!-- Google Sheets -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/settings_section_sheets"
            android:textColor="#222222"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/sheetsUrlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/settings_sheets_hint"
            android:inputType="textUri"
            android:background="@drawable/edit_text_bg"
            android:padding="12dp"
            android:textColor="#222222"
            android:textColorHint="#9CA39A"
            android:textSize="14sp"
            android:fontFamily="monospace" />

        <!-- Telegram -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_section_telegram"
            android:textColor="#222222"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/telegramTokenInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/settings_telegram_token_hint"
            android:inputType="textVisiblePassword"
            android:background="@drawable/edit_text_bg"
            android:padding="12dp"
            android:textColor="#222222"
            android:textColorHint="#9CA39A"
            android:textSize="14sp"
            android:fontFamily="monospace" />

        <EditText
            android:id="@+id/telegramChatInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/settings_telegram_chat_hint"
            android:inputType="text"
            android:background="@drawable/edit_text_bg"
            android:padding="12dp"
            android:textColor="#222222"
            android:textColorHint="#9CA39A"
            android:textSize="14sp"
            android:fontFamily="monospace" />

        <!-- Save -->
        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:minHeight="52dp"
            android:text="@string/settings_save"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/btn_primary_bg" />
    </LinearLayout>
</ScrollView>
