<?xml version="1.0" encoding="utf-8"?>
<!-- Compact danger-outline pill for the per-row delete affordance. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FBEAEA" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#F3C8C8" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#F3D2D2" />
        </shape>
    </item>
</selector>
